---
import CrossBowLogo from './ui/CrossBowLogo.astro';
import { site } from '../config/site';
---
<footer class="site-footer">
  <p class="site-footer__love">
    Brought to you with
    <svg class="site-footer__heart" viewBox="0 0 256 256" aria-label="love" role="img"><path d="M240,98a57.63,57.63,0,0,1-17,41L133.7,229.62a8,8,0,0,1-11.4,0L33,139a58,58,0,0,1,82-82.1L128,69.05l13.09-12.19A58,58,0,0,1,240,98Z"/></svg>
    by <a href="#about" class="nounder">{site.brand}</a>
  </p>
  <a href="#top" class="site-footer__mark nounder" aria-label="Back to top">
    <CrossBowLogo size={72} />
  </a>
</footer>

<style>
  .site-footer {
    margin: 40px 0 20px;
    text-align: center;
  }
  .site-footer__love {
    color: var(--light-font-color);
    font-size: 0.8em;
    font-style: italic;
    margin-bottom: 12px;
  }
  .site-footer__heart {
    width: 1.1em;
    height: 1.1em;
    vertical-align: -0.2em;
    fill: var(--accent-color);
  }
  .site-footer__mark {
    display: inline-block;
    color: var(--emblem-color);
    transition: transform 0.3s ease, color 0.3s ease;
  }
  .site-footer__mark:hover {
    color: var(--accent-color);
    transform: translateY(-3px);
  }
</style>
