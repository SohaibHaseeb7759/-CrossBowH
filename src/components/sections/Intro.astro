---
import Card from '../ui/Card.astro';
import { announcement, intro } from '../../config/site';
import { withName } from '../../lib/content';
const parts = withName(intro.text);
const ctas = [intro.primaryCta, intro.secondaryCta].filter((c) => c && c.label);
---
<div class="intro twox">
  <p class="intro__text">
    {parts.map((p) => (p.isName ? <span class="accent">{p.text}</span> : p.text))}
  </p>
  {ctas.length > 0 && (
    <p class="intro__ctas">
      {ctas.map((c, i) => (
        <>
          {i > 0 && <span class="muted" aria-hidden="true"> • </span>}
          <a href={c.href}>{c.label}</a> »
        </>
      ))}
    </p>
  )}
</div>

{announcement && (
  <Card variant="notice" wide>
    {announcement.text}
    {announcement.href && announcement.linkLabel && <> <a href={announcement.href}>{announcement.linkLabel}</a></>}
  </Card>
)}

<style>
  .intro__text { margin-bottom: 8px; }
  .intro__ctas { margin: 0; }
</style>
