---
/**
 * Large decorative #CrossBowH emblem (fills the space the reference uses for its badge art).
 * A targeting dial: thick accent ring with the brand set along it, range ticks, and the mark in the centre.
 * Pure SVG, recolours with the theme.
 */
import { site } from '../../config/site';
interface Props { class?: string }
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
// The ring is open at the lower left (see stroke-dasharray below); text is laid only on the visible arc.
const ringText = `${site.brand.toUpperCase()} · SECURE · TARGET · VERIFY · ${site.brand.toUpperCase()} · TRACE · PROTECT`;
---
<svg
  class:list={['emblem', Astro.props.class]}
  viewBox="0 0 500 500"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${site.brand} emblem`}
>
  <defs>
    <path id="emblem-ring-path" d="M250 250 m-207 0 a207 207 0 1 1 414 0 a207 207 0 1 1 -414 0" />
  </defs>

  <!-- outer ring, open at the lower left like a drawn bow -->
  <circle cx="250" cy="250" r="214" fill="none" stroke="var(--emblem-color)" stroke-width="52"
    stroke-dasharray="1180 165" transform="rotate(118 250 250)" />
  <!-- path starts at 9 o'clock; rotate it to begin just after the ring's opening -->
  <g transform="rotate(-52 250 250)">
    <text class="emblem__ring-text" fill="var(--background-color)">
      <textPath href="#emblem-ring-path" textLength="1085" lengthAdjust="spacing">{ringText}</textPath>
    </text>
  </g>

  <!-- inner dial -->
  <circle cx="250" cy="250" r="160" fill="none" stroke="var(--emblem-color)" stroke-width="3" />
  <circle cx="250" cy="250" r="146" fill="color-mix(in srgb, var(--emblem-color) 9%, var(--background-color))" />
  {ticks.map((deg) => (
    <line
      x1="250" y1={deg % 45 === 0 ? 92 : 98} x2="250" y2="104"
      stroke="var(--emblem-color)" stroke-width={deg % 45 === 0 ? 3 : 1.5}
      transform={`rotate(${deg} 250 250)`}
    />
  ))}

  <!-- crosshair -->
  <path d="M250 112 V160 M250 340 V388 M112 250 H160 M340 250 H388"
    stroke="var(--emblem-color)" stroke-width="3" stroke-linecap="round" />
  <circle cx="250" cy="250" r="96" fill="none" stroke="var(--emblem-color)" stroke-width="1.5" stroke-dasharray="4 8" />

  <!-- the mark -->
  <g transform="translate(178 172) scale(2.25)" fill="none" stroke="var(--emblem-color)"
    stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 25 Q32 9 59 25" stroke-width="5" />
    <path d="M21 17 V59 M43 17 V59" stroke-width="5" />
    <path d="M9 42 H55" stroke-width="5" />
    <path d="M32 52 V14" stroke-width="3.5" />
    <path d="M32 2.5 L38.5 14 H25.5 Z" fill="var(--emblem-color)" stroke-width="2" />
    <path d="M27.5 57 L32 52 L36.5 57" stroke-width="3" />
  </g>
</svg>

<style>
  .emblem {
    width: 100%;
    max-width: 500px;
    height: auto;
    display: block;
  }
  .emblem__ring-text {
    font-family: 'Orbitron', var(--font-mono);
    font-size: 18px;
    font-weight: 600;
  }
</style>
