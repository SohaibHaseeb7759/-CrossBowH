---
import CrossBowLogo from './CrossBowLogo.astro';
import { site } from '../../config/site';
interface Props { class?: string }
---
<span class:list={['wordmark', Astro.props.class]}>
  <CrossBowLogo size="1.15em" class="wordmark__mark" />
  <span class="wordmark__text">{site.brand}</span>
  <span class="wordmark__caret" aria-hidden="true">&gt;</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: 'Orbitron', var(--font-sans);
    font-weight: 500;
    font-size: 26px;
    letter-spacing: 0.09em;
    line-height: 1;
    color: var(--brand-color);
    white-space: nowrap;
  }
  .wordmark__caret {
    font-weight: 400;
    margin-left: 0.1em;
  }
  @media (max-width: 480px) {
    .wordmark { font-size: 19px; letter-spacing: 0.06em; }
  }
  @media (max-width: 360px) {
    .wordmark { font-size: 16px; }
  }
</style>
