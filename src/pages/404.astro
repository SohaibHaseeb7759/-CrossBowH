---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title={`Not found — ${site.brand}`} description="This page could not be found.">
  <div class="notfound">
    <h1>404<span class="accent">.</span></h1>
    <p>That target is out of range. The page you were looking for doesn't exist.</p>
    <p><a href="/">« Back to the home page</a></p>
  </div>
</BaseLayout>
<style>
  .notfound { max-width: 800px; margin: 40px auto; }
  h1 { font-size: 35px; }
</style>
